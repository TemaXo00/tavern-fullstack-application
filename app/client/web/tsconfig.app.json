{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "types": ["vite/client"],
    "rootDir": "src",
    "jsx": "preserve",
    "jsxImportSource": "vue",
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "tsBuildInfoFile": "dist/tsconfig.app.tsbuildinfo",
    "lib": ["DOM"]
  },
  "exclude": [
    "out-tsc",
    "dist",
    "src/**/*.spec.ts",
    "src/**/*.test.ts",
    "src/**/*.spec.vue",
    "src/**/*.test.vue",
    "eslint.config.js",
    "eslint.config.cjs",
    "eslint.config.mjs"
  ],
  "include": ["src/**/*.js", "src/**/*.jsx", "src/**/*.ts", "src/**/*.vue"],
  "references": [
    {
      "path": "../../client-libs/auth-register-page/tsconfig.lib.json"
    },
    {
      "path": "../../client-libs/auth-login-page/tsconfig.lib.json"
    },
    {
      "path": "../../client-libs/auth-layout/tsconfig.lib.json"
    },
    {
      "path": "../../client-libs/admin-home-page/tsconfig.lib.json"
    },
    {
      "path": "../../client-libs/admin-layout/tsconfig.lib.json"
    },
    {
      "path": "../../client-libs/main-home-page/tsconfig.lib.json"
    },
    {
      "path": "../../client-libs/main-layout/tsconfig.lib.json"
    },
    {
      "path": "../../core-libs/enums/tsconfig.lib.json"
    },
    {
      "path": "../../client-libs/api-client/tsconfig.lib.json"
    }
  ]
}
