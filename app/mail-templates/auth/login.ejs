<%
  const theme = {}
  const webLink = typeof link !== 'undefined' && link ? link : 'http://localhost:4200'
  const currentYear = typeof year !== 'undefined' && year ? year : new Date().getFullYear()
  const baseLink = webLink.replace(/\/+$/, '')
  const forgotLink = baseLink + '/auth/forgot-password'
  const title = 'New sign-in to TAVERN'
  const preheader = 'A new sign-in to your TAVERN account was detected.'
  const eyebrow = 'Security notice'
  const session = {
    device: typeof device !== 'undefined' && device ? device : 'Unknown device',
    browser: typeof browser !== 'undefined' && browser ? browser : 'Unknown browser',
    os: typeof os !== 'undefined' && os ? os : 'Unknown operating system',
  }
-%>
<%- include('./partials/layout/page-start', { theme, title, preheader, eyebrow, link: webLink }) %>

<%- include('./partials/components/heading', { theme, text: 'New sign-in to your account' }) %>
<%- include('./partials/components/paragraph', { theme, text: 'A new sign-in to your TAVERN account was detected. If this was you, no action is needed.' }) %>

<%- include('./partials/components/detail-list', { theme, title: 'Session details', items: [
  { label: 'Device', value: session.device },
  { label: 'Browser', value: session.browser },
  { label: 'Operating system', value: session.os }
] }) %>

<%- include('./partials/components/button', { theme, href: webLink, label: 'Open TAVERN' }) %>
<%- include('./partials/components/callout', { theme, tone: 'inverse', title: 'If this was not you', text: 'Your password may be compromised. Reset it now and review your active sessions.' }) %>
<%- include('./partials/components/button', { theme, href: forgotLink, label: 'Reset password', variant: 'secondary', top: '16px' }) %>

<%- include('./partials/layout/page-end', { theme, link: webLink, year: currentYear }) %>
