<%
  const theme = {}
  const webLink = typeof link !== 'undefined' && link ? link : 'http://localhost:4200'
  const currentYear = typeof year !== 'undefined' && year ? year : new Date().getFullYear()
  const title = 'Your TAVERN account has been deleted'
  const preheader = 'Your TAVERN account and its sessions have been removed.'
  const eyebrow = 'Account deleted'
-%>
<%- include('./partials/layout/page-start', { theme, title, preheader, eyebrow, link: webLink }) %>

<%- include('./partials/components/heading', { theme, text: 'Your TAVERN account has been deleted' }) %>
<%- include('./partials/components/paragraph', { theme, text: 'Your TAVERN account has been deleted. This address will no longer receive account notifications.' }) %>
<%- include('./partials/components/list', { theme, items: [
  'Your account and its sessions have been removed.',
  'Your profile is no longer available.',
  'This action cannot be undone.'
] }) %>
<%- include('./partials/components/callout', { theme, title: 'Need help?', text: 'If you believe this was a mistake, contact TAVERN support as soon as possible.' }) %>

<%- include('./partials/layout/page-end', { theme, link: webLink, year: currentYear }) %>
