<%
  const dividerSpacing = typeof spacing !== 'undefined' ? spacing : '28px 0 0'
%>
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin: <%= dividerSpacing %>;">
  <tr>
    <td style="border-top: 1px solid <%= theme.colors.border %>; font-size: 0; line-height: 0; height: 1px;">&nbsp;</td>
  </tr>
</table>
