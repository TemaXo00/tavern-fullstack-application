<%
  const listItems = typeof items !== 'undefined' && Array.isArray(items) ? items : []
  const listHtml = typeof allowHtml !== 'undefined' ? allowHtml : false
  const listMargin = typeof margin !== 'undefined' ? margin : '8px 0 0'
%>
<% if (listItems.length) { %>
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin: <%= listMargin %>;">
  <% listItems.forEach(function (item) { %>
  <tr>
    <td width="18" valign="top" style="padding: 0 0 10px; font-family: <%= theme.fonts.sans %>; font-size: 15px; line-height: 24px; color: <%= theme.colors.muted %>;">&bull;</td>
    <td valign="top" style="padding: 0 0 10px; font-family: <%= theme.fonts.sans %>; font-size: 15px; line-height: 24px; color: <%= theme.colors.muted %>;">
      <% if (listHtml) { %><%- item %><% } else { %><%= item %><% } %>
    </td>
  </tr>
  <% }) %>
</table>
<% } %>
