      lang: 'en',
      brand: 'TAVERN',
      webLinkLabel: 'Open the web interface',
      footerNote: 'A place for events, people, and stories.',
      copyright: 'All rights reserved.',
    },
    colors: {
      page: '#f4f4f5',
      card: '#ffffff',
      text: '#111111',
      muted: '#52525b',
      subtle: '#71717a',
      border: '#e4e4e7',
      surface: '#f4f4f5',
      surfaceStrong: '#e4e4e7',
      inverse: '#111111',
      inverseText: '#ffffff',
      inverseMuted: '#d4d4d8',
      inverseBorder: '#3f3f46',
      link: '#111111',
      linkInverse: '#ffffff',
      button: '#111111',
      buttonText: '#ffffff',
      buttonSecondary: '#ffffff',
      buttonSecondaryText: '#111111',
      buttonSecondaryBorder: '#d4d4d8',
