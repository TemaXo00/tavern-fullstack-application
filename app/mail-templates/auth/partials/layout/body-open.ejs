<%
  const bodyLink = typeof link !== 'undefined' && link ? link : '#'
  const bodyPreheader = typeof preheader !== 'undefined' ? preheader : ''
  const bodyEyebrow = typeof eyebrow !== 'undefined' ? eyebrow : ''
%>
<body style="margin: 0; padding: 0; width: 100%; background-color: <%= theme.colors.page %>;">
  <% if (bodyPreheader) { %>
  <div style="display: none; font-size: 1px; line-height: 1px; max-height: 0; max-width: 0; opacity: 0; overflow: hidden; mso-hide: all; color: <%= theme.colors.page %>;">
    <%= bodyPreheader %>
  </div>
  <% } %>

  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="width: 100%; background-color: <%= theme.colors.page %>;">
    <tr>
      <td align="center" style="padding: 32px 16px;">
        <table
          role="presentation"
          width="<%= theme.layout.width %>"
          cellpadding="0"
          cellspacing="0"
          border="0"
          class="email-container"
          style="width: 100%; max-width: <%= theme.layout.width %>px; background-color: <%= theme.colors.card %>; border: 1px solid <%= theme.colors.border %>; border-radius: <%= theme.radius.lg %>px; border-collapse: separate; border-spacing: 0;"
        >
          <tr>
            <td>
              <%- include('./header', { theme, link: bodyLink, eyebrow: bodyEyebrow }) %>
            </td>
          </tr>
          <tr>
            <td class="email-card-padding" style="padding: <%= theme.layout.cardPadding %>px <%= theme.layout.cardPadding %>px 32px;">
