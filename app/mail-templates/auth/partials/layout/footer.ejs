<%
  const footerLink = typeof link !== 'undefined' && link ? link : '#'
  const footerYear = typeof year !== 'undefined' && year ? year : new Date().getFullYear()
%>
<table
  role="presentation"
  width="<%= theme.layout.width %>"
  cellpadding="0"
  cellspacing="0"
  border="0"
  align="center"
  class="email-container"
  style="width: 100%; max-width: <%= theme.layout.width %>px;"
>
  <tr>
    <td align="center" style="font-family: <%= theme.fonts.sans %>;">
      <p style="margin: 0 0 10px; font-size: 11px; line-height: 16px; font-weight: 700; letter-spacing: 0.18em; text-transform: uppercase; color: <%= theme.colors.inverseMuted %>;">
        <%= theme.meta.brand %>
      </p>
      <p style="margin: 0 0 16px; font-size: 14px; line-height: 22px; color: <%= theme.colors.inverseMuted %>;">
        <%= theme.meta.footerNote %>
      </p>
      <p style="margin: 0 0 10px;">
        <a
          href="<%= footerLink %>"
          target="_blank"
          rel="noopener noreferrer"
          style="font-size: 14px; line-height: 22px; font-weight: 700; color: <%= theme.colors.inverseText %>; text-decoration: underline;"
        ><%= theme.meta.webLinkLabel %></a>
      </p>
      <p style="margin: 0 0 16px; font-size: 12px; line-height: 18px; color: <%= theme.colors.inverseMuted %>; word-break: break-all;">
        <a href="<%= footerLink %>" target="_blank" rel="noopener noreferrer" style="color: <%= theme.colors.inverseMuted %>; text-decoration: none;"><%= footerLink %></a>
      </p>
      <p style="margin: 0; font-size: 12px; line-height: 18px; color: <%= theme.colors.inverseMuted %>;">
        &copy; <%= footerYear %> <%= theme.meta.brand %>. <%= theme.meta.copyright %>
      </p>
    </td>
  </tr>
</table>
