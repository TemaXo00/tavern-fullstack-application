<%
  const theme = {}
  const webLink = typeof link !== 'undefined' && link ? link : 'http://localhost:4200'
  const currentYear = typeof year !== 'undefined' && year ? year : new Date().getFullYear()
  const baseLink = webLink.replace(/\/+$/, '')
  const loginLink = baseLink + '/auth/login'
  const title = 'Your TAVERN password was updated'
  const preheader = 'Your TAVERN password has been changed successfully.'
  const eyebrow = 'Password updated'
  const session = {
    device: typeof device !== 'undefined' && device ? device : 'Unknown device',
    browser: typeof browser !== 'undefined' && browser ? browser : 'Unknown browser',
    os: typeof os !== 'undefined' && os ? os : 'Unknown operating system',
  }
-%>
<%- include('./partials/layout/page-start', { theme, title, preheader, eyebrow, link: webLink }) %>

<%- include('./partials/components/heading', { theme, text: 'Your password has been updated' }) %>
<%- include('./partials/components/paragraph', { theme, text: 'Your TAVERN password has been changed successfully. You can now sign in with your new password.' }) %>
<%- include('./partials/components/button', { theme, href: loginLink, label: 'Sign in to TAVERN' }) %>

<%- include('./partials/components/divider', { theme }) %>
<%- include('./partials/components/paragraph', { theme, text: 'Session details', muted: true, size: '13px', lineHeight: '20px', margin: '20px 0 10px' }) %>
<%- include('./partials/components/detail-list', { theme, items: [
  { label: 'Device', value: session.device },
  { label: 'Browser', value: session.browser },
  { label: 'Operating system', value: session.os }
] }) %>

<%- include('./partials/components/callout', { theme, tone: 'inverse', title: "If this wasn't you", text: 'Someone may have access to your account. Reset your password again and contact TAVERN support immediately.' }) %>

<%- include('./partials/layout/page-end', { theme, link: webLink, year: currentYear }) %>
