<%
  const theme = {}
  const webLink = typeof link !== 'undefined' && link ? link : 'http://localhost:4200'
  const currentYear = typeof year !== 'undefined' && year ? year : new Date().getFullYear()
  const baseLink = webLink.replace(/\/+$/, '')
  const resetToken = typeof token !== 'undefined' && token ? token : ''
  const resetLink = resetToken
    ? baseLink + '/auth/reset-password/' + encodeURIComponent(resetToken)
    : baseLink + '/auth/forgot-password'
  const title = 'Reset your TAVERN password'
  const preheader = 'Use the button below to choose a new TAVERN password.'
  const eyebrow = 'Password reset'
-%>
<%- include('./partials/layout/page-start', { theme, title, preheader, eyebrow, link: webLink }) %>

<%- include('./partials/components/heading', { theme, text: 'Reset your TAVERN password' }) %>
<%- include('./partials/components/paragraph', { theme, text: 'We received a request to reset the password for your TAVERN account. Use the button below to choose a new password.' }) %>
<%- include('./partials/components/button', { theme, href: resetLink, label: 'Reset password' }) %>
<%- include('./partials/components/paragraph', { theme, text: 'This link can be used once. If it expires, request a new one from the sign-in page.', muted: true, size: '13px', lineHeight: '20px', margin: '16px 0 0' }) %>
<%- include('./partials/components/code', { theme, label: 'Or copy this link into your browser', value: resetLink }) %>
<%- include('./partials/components/callout', { theme, title: "Didn't request this?", text: 'You can safely ignore this email. Your password will not change until you use the reset link.' }) %>

<%- include('./partials/layout/page-end', { theme, link: webLink, year: currentYear }) %>
