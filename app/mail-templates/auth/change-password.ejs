<%
  const theme = {}
  const webLink = typeof link !== 'undefined' && link ? link : 'http://localhost:4200'
  const currentYear = typeof year !== 'undefined' && year ? year : new Date().getFullYear()
  const title = 'Your TAVERN password was changed'
  const preheader = 'Your TAVERN password has been changed.'
  const eyebrow = 'Password updated'
  const session = {
    device: typeof device !== 'undefined' && device ? device : 'Unknown device',
    browser: typeof browser !== 'undefined' && browser ? browser : 'Unknown browser',
    os: typeof os !== 'undefined' && os ? os : 'Unknown operating system',
  }
-%>
<%- include('./partials/layout/page-start', { theme, title, preheader, eyebrow, link: webLink }) %>

<%- include('./partials/components/heading', { theme, text: 'Your TAVERN password was changed' }) %>
<%- include('./partials/components/paragraph', { theme, text: 'Your TAVERN password has been changed successfully. Use your new password the next time you sign in.' }) %>

<%- include('./partials/components/detail-list', { theme, title: 'Session details', items: [
  { label: 'Device', value: session.device },
  { label: 'Browser', value: session.browser },
  { label: 'Operating system', value: session.os }
] }) %>

<%- include('./partials/components/button', { theme, href: webLink, label: 'Review active sessions' }) %>
<%- include('./partials/components/callout', { theme, tone: 'inverse', title: "If this wasn't you", text: 'Reset your password immediately and terminate any sessions you do not recognize.' }) %>

<%- include('./partials/layout/page-end', { theme, link: webLink, year: currentYear }) %>
