# ALL_APPS_CONFIG
TAVERN_DEV_MODE=true

# PORTS
TAVERN_GATEWAY_HTTP_PORT=3000
TAVERN_AUTH_GRPC_PORT=5000
TAVERN_BLOG_GRPC_PORT=5001
TAVERN_EVENT_GRPC_PORT=5002
TAVERN_LOG_GRPC_PORT=5003
TAVERN_PROFILE_GRPC_PORT=5004

# GATEWAY_CONFIG
TAVERN_GATEWAY_CORS_ORIGINS=http://localhost:3001
TAVERN_GATEWAY_WINDOW_MS_MINUTES=20
TAVERN_GATEWAY_REQUEST_LIMIT=3000

# GRPC_URLS

TAVERN_AUTH_GRPC_URL=localhost:5000
TAVERN_BLOG_GRPC_URL=localhost:5001
TAVERN_EVENT_GRPC_URL=localhost:5002
TAVERN_LOG_GRPC_URL=localhost:5003
TAVERN_PROFILE_GRPC_URL=localhost:5004

# JWT
TAVERN_JWT_SECRET=SuperSecretJWTSecret
TAVERN_JWT_ACCESS_TOKEN_TTL=15 # Minutes
TAVERN_JWT_REFRESH_TOKEN_TTL=30 # Days

# MAIL
TAVERN_MAIL_FROM=user@example.com
TAVERN_MAIL_TRANSPORT_HOST=smtp.gmail.com
TAVERN_MAIL_TRANSPORT_PORT=587
TAVERN_MAIL_SECURE_ENABLE=false
TAVERN_MAIL_USER=user@example.com
TAVERN_MAIL_PASSWORD=strong-password-123456
TAVERN_WEB_CLIENT_LINK=http://localhost:4200

# RMQ
TAVERN_RMQ_USER=temaxo
TAVERN_RMQ_PASSWORD=050906
TAVERN_RMQ_URL=localhost:5672

# REDIS
TAVERN_REDIS_URL=localhost:6379
TAVERN_REDIS_PASSWORD=123456

TAVERN_PROFILE_CACHE_TTL=300
TAVERN_EVENT_TAG_CACHE_TTL=300
TAVERN_EVENT_CACHE_TTL=300
TAVERN_EVENT_USERPAGE_TTL=90

# DB_URLS
TAVERN_AUTH_DB_URL=postgresql://temaxo:050906@localhost:5432/auth?schema=public
TAVERN_PROFILE_DB_URL=postgresql://temaxo:050906@localhost:5433/profile?schema=public
TAVERN_EVENT_DB_URL=postgresql://temaxo:050906@localhost:5434/event?schema=public
TAVERN_BLOG_DB_URL=postgresql://temaxo:050906@localhost:5435/blog?schema=public
TAVERN_LOG_DB_URL=postgresql://temaxo:050906@localhost:5436/log?schema=public
