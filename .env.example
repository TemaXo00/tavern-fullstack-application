# PRODUCTION CONFIG

DOCKER_REGISTRY=registry.temaxo.com:80
DOCKER_APPS_PROD_VERSION=v0.5.0
DOCKER_APPS_DEV_VERSION=dev

# PORTS
TAVERN_API_PORT=3000

# JWT
TAVERN_JWT_SECRET=SuperSecretJWTSecret
TAVERN_JWT_ACCESS_TOKEN_TTL=15 # Minutes
TAVERN_JWT_REFRESH_TOKEN_TTL=30 # Days

# APP CONFIGS

TAVERN_AUTH_GRPC_URL=auth-service:5000
TAVERN_PROFILE_GRPC_URL=profile-service:5000
TAVERN_EVENT_GRPC_URL=event-service:5000
TAVERN_BLOG_GRPC_URL=blog-service:5000
TAVERN_LOG_GRPC_URL=log-service:5000

TAVERN_REPUTATION_SCORE_EVENT=60
TAVERN_REPUTATION_SCORE_BLOCK=-30
TAVERN_REPUTATION_SCORE_EARLY_UNBLOCK=30
TAVERN_REPUTATION_SCORE_REPORT=-10

TAVERN_SOCIALS_MAX_COUNT=5

TAVERN_PROFILE_CACHE_TTL=200
TAVERN_EVENT_TAG_CACHE_TTL=200
TAVERN_EVENT_CACHE_TTL=300
TAVERN_EVENT_USERPAGE_TTL=90
TAVERN_BLOG_TAG_CACHE_TTL=200
TAVERN_BLOG_ARTICLE_CACHE_TTL=300

TAVERN_ALLOWED_ORIGINS=http://localhost:3001
TAVERN_WINDOW_MS_MINUTES=20
TAVERN_REQUEST_LIMIT=3000

TAVERN_MAIL_FROM=noreply@tavern.com
TAVERN_MAIL_TRANSPORT_HOST=mailpit
TAVERN_MAIL_TRANSPORT_PORT=1025
TAVERN_MAIL_SECURE_ENABLE=false
TAVERN_MAIL_USER=
TAVERN_MAIL_PASSWORD=
TAVERN_WEB_CLIENT_LINK=http://localhost:4200

# REDIS
TAVERN_REDIS_URL=redis:6379
TAVERN_REDIS_PASSWORD=123456

# RABBITMQ
TAVERN_RMQ_USER=temaxo
TAVERN_RMQ_PASSWORD=050906
TAVERN_RMQ_URL=rabbitmq:5672

# AUTH DB
TAVERN_AUTH_DB_NAME=auth
TAVERN_AUTH_DB_USER=temaxo
TAVERN_AUTH_DB_PASSWORD=050906
TAVERN_AUTH_DB_URL=postgresql://${TAVERN_AUTH_DB_USER}:${TAVERN_AUTH_DB_PASSWORD}@auth-db:5432/${TAVERN_AUTH_DB_NAME}?schema=public

# PROFILE DB
TAVERN_PROFILE_DB_NAME=profile
TAVERN_PROFILE_DB_USER=temaxo
TAVERN_PROFILE_DB_PASSWORD=050906
TAVERN_PROFILE_DB_URL=postgresql://${TAVERN_PROFILE_DB_USER}:${TAVERN_PROFILE_DB_PASSWORD}@profile-db:5432/${TAVERN_PROFILE_DB_NAME}?schema=public

# EVENT DB
TAVERN_EVENT_DB_NAME=event
TAVERN_EVENT_DB_USER=temaxo
TAVERN_EVENT_DB_PASSWORD=050906
TAVERN_EVENT_DB_URL=postgresql://${TAVERN_EVENT_DB_USER}:${TAVERN_EVENT_DB_PASSWORD}@event-db:5432/${TAVERN_EVENT_DB_NAME}?schema=public

# BLOG DB
TAVERN_BLOG_DB_NAME=blog
TAVERN_BLOG_DB_USER=temaxo
TAVERN_BLOG_DB_PASSWORD=050906
TAVERN_BLOG_DB_URL=postgresql://${TAVERN_BLOG_DB_USER}:${TAVERN_BLOG_DB_PASSWORD}@blog-db:5432/${TAVERN_BLOG_DB_NAME}?schema=public

# LOG DB
TAVERN_LOG_DB_NAME=log
TAVERN_LOG_DB_USER=temaxo
TAVERN_LOG_DB_PASSWORD=050906
TAVERN_LOG_DB_URL=postgresql://${TAVERN_LOG_DB_USER}:${TAVERN_LOG_DB_PASSWORD}@log-db:5432/${TAVERN_LOG_DB_NAME}?schema=public

# ---

